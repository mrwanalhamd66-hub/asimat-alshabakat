      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sectionType": { "type": "string", "enum": ["hero", "featured_products", "latest_offers", "exclusive_products", "new_arrivals", "best_sellers", "categories", "brands", "advertisements", "announcements", "custom_banner", "contact_support"] },
        "titleAr": { "type": "string", "maxLength": 160 },
        "titleEn": { "type": "string", "maxLength": 160 },
        "subtitleAr": { "type": "string", "maxLength": 400 },
        "subtitleEn": { "type": "string", "maxLength": 400 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "ctaTextAr": { "type": "string", "maxLength": 80 },
        "ctaTextEn": { "type": "string", "maxLength": 80 },
        "ctaLink": { "type": "string", "maxLength": 200 },
        "selectedProductIds": { "type": "array", "description": "Featured product IDs (max 12)." },
        "selectedOfferIds": { "type": "array", "description": "Featured offer IDs (max 12)." },
        "order": { "type": "integer" },
        "isEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "sectionType", "titleAr", "titleEn", "order", "isEnabled", "updatedAt"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Public store settings, announcements, contact info, and enabled payment options.",
      "type": "object",
