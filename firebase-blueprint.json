{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered customer, trainer, manager, or super admin profile with role-based permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "displayName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "governorate": { "type": "string", "maxLength": 60 },
        "address": { "type": "string", "maxLength": 300 },
        "role": { "type": "string", "enum": ["super_admin", "manager", "trainer", "customer"] },
        "permissions": { "type": "array", "description": "Assigned admin/trainer modules (max 30)." },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Public networking equipment product catalog item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nameAr": { "type": "string", "maxLength": 160 },
        "nameEn": { "type": "string", "maxLength": 160 },
        "descriptionAr": { "type": "string", "maxLength": 3000 },
        "descriptionEn": { "type": "string", "maxLength": 3000 },
        "specsAr": { "type": "string", "maxLength": 3000 },
        "specsEn": { "type": "string", "maxLength": 3000 },
        "brandId": { "type": "string", "maxLength": 128 },
        "brandName": { "type": "string", "maxLength": 100 },
        "modelNumber": { "type": "string", "maxLength": 100 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryNameAr": { "type": "string", "maxLength": 100 },
        "categoryNameEn": { "type": "string", "maxLength": 100 },
        "retailPrice": { "type": "number" },
        "previousPrice": { "type": "number" },
        "discountPercentage": { "type": "number" },
        "availableQuantity": { "type": "integer" },
        "status": { "type": "string", "enum": ["available", "limited_stock", "out_of_stock", "coming_soon", "discontinued"] },
        "isFeatured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isExclusive": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "tags": { "type": "array", "description": "Product tags (max 10)." },
        "images": { "type": "array", "description": "Product image URLs (max 8)." },
        "documentationUrl": { "type": "string", "maxLength": 500 },
        "warrantyAr": { "type": "string", "maxLength": 200 },
        "warrantyEn": { "type": "string", "maxLength": 200 },
        "viewCount": { "type": "integer" },
        "reservationCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nameAr", "nameEn", "brandId", "categoryId", "retailPrice", "availableQuantity", "status", "isPublished", "createdAt"]
    },
    "ProductPrivate": {
      "title": "ProductPrivate",
      "description": "Admin-only wholesale pricing and supplier metadata.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "wholesalePrice": { "type": "number" },
        "supplierNotes": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "wholesalePrice", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Networking product category.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nameAr": { "type": "string", "maxLength": 100 },
        "nameEn": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "descriptionAr": { "type": "string", "maxLength": 500 },
        "descriptionEn": { "type": "string", "maxLength": 500 },
        "icon": { "type": "string", "maxLength": 60 },
        "order": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nameAr", "nameEn", "slug", "order", "isActive", "createdAt"]
    },
    "Brand": {
      "title": "Brand",
      "description": "Hardware brand (MikroTik, Ubiquiti, TP-Link, OpenWrt, etc.).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nameAr": { "type": "string", "maxLength": 100 },
        "nameEn": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 80 },
        "logoText": { "type": "string", "maxLength": 60 },
        "isFeatured": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nameAr", "nameEn", "slug", "isFeatured", "isActive", "createdAt"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Dynamic scheduled offer or promotion.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "titleAr": { "type": "string", "maxLength": 160 },
        "titleEn": { "type": "string", "maxLength": 160 },
        "descriptionAr": { "type": "string", "maxLength": 1500 },
        "descriptionEn": { "type": "string", "maxLength": 1500 },
        "sectionType": { "type": "string", "enum": ["today_deals", "weekly_offers", "exclusive_offers", "limited_time", "wholesale_offers", "new_promotions"] },
        "productId": { "type": "string", "maxLength": 128 },
        "productNameAr": { "type": "string", "maxLength": 160 },
        "productNameEn": { "type": "string", "maxLength": 160 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "originalPrice": { "type": "number" },
        "discountedPrice": { "type": "number" },
        "availableQuantity": { "type": "integer" },
        "startDate": { "type": "string", "maxLength": 40 },
        "endDate": { "type": "string", "maxLength": 40 },
        "isFeatured": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "autoActivate": { "type": "boolean" },
        "autoExpire": { "type": "boolean" },
        "clickCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "titleAr", "titleEn", "sectionType", "productId", "originalPrice", "discountedPrice", "startDate", "endDate", "isActive", "createdAt"]
    },
    "Advertisement": {
      "title": "Advertisement",
      "description": "Scheduled advertisement banner, poster, popup, or announcement.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "titleAr": { "type": "string", "maxLength": 160 },
        "titleEn": { "type": "string", "maxLength": 160 },
        "textAr": { "type": "string", "maxLength": 600 },
        "textEn": { "type": "string", "maxLength": 600 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "adType": { "type": "string", "enum": ["homepage_banner", "promotional_poster", "product_ad", "special_campaign", "brand_ad", "seasonal_offer", "announcement_banner", "popup_ad"] },
        "displayLocation": { "type": "string", "maxLength": 80 },
        "targetPage": { "type": "string", "maxLength": 80 },
        "destinationUrl": { "type": "string", "maxLength": 300 },
        "startDate": { "type": "string", "maxLength": 40 },
        "endDate": { "type": "string", "maxLength": 40 },
        "priority": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "impressions": { "type": "integer" },
        "clicks": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "titleAr", "titleEn", "adType", "displayLocation", "startDate", "endDate", "priority", "isActive", "createdAt"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "Customer product reservation record (PII protected).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referenceNumber": { "type": "string", "maxLength": 40, "pattern": "^ASM-[0-9]{6}$" },
        "batchId": { "type": "string", "maxLength": 80 },
        "customerUid": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "governorate": { "type": "string", "maxLength": 60 },
        "address": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 600 },
        "productId": { "type": "string", "maxLength": 128 },
        "productNameAr": { "type": "string", "maxLength": 160 },
        "productNameEn": { "type": "string", "maxLength": 160 },
        "unitPrice": { "type": "number" },
        "quantity": { "type": "integer" },
        "discountAmount": { "type": "number" },
        "shippingCost": { "type": "number" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "preparing", "ready_for_pickup", "out_for_delivery", "completed", "cancelled"] },
        "paymentMethod": { "type": "string", "maxLength": 60 },
        "invoiceId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "referenceNumber", "customerName", "phone", "governorate", "address", "productId", "quantity", "totalPrice", "status", "createdAt"]
    },
    "ReservationTracking": {
      "title": "ReservationTracking",
      "description": "Public-safe reservation status lookup keyed by referenceNumber_phone (no street address PII).",
      "type": "object",
      "properties": {
        "trackingId": { "type": "string", "maxLength": 80, "pattern": "^ASM-[0-9]{6}_[0-9]{7,15}$" },
        "reservationId": { "type": "string", "maxLength": 128 },
        "referenceNumber": { "type": "string", "maxLength": 40 },
        "productNameAr": { "type": "string", "maxLength": 160 },
        "productNameEn": { "type": "string", "maxLength": 160 },
        "quantity": { "type": "integer" },
        "totalPrice": { "type": "number" },
        "governorate": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "preparing", "ready_for_pickup", "out_for_delivery", "completed", "cancelled"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["trackingId", "reservationId", "referenceNumber", "productNameAr", "quantity", "totalPrice", "status", "updatedAt"]
    },
    "HomepageSection": {
      "title": "HomepageSection",
      "description": "Configurable homepage section managed from Admin Homepage Builder.",
