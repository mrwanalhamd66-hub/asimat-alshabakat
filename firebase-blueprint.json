      "required": ["id", "storeNameAr", "storeNameEn", "locationAr", "locationEn", "phones", "currencyCode", "updatedAt"]
    },
    "AdminSettings": {
      "title": "AdminSettings",
      "description": "Private Super Admin integration settings for future WhatsApp Business API & payment gateways.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "whatsappBusinessPhoneId": { "type": "string", "maxLength": 120 },
