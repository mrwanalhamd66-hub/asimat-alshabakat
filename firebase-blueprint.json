        "messageEn": { "type": "string", "maxLength": 500 },
        "relatedId": { "type": "string", "maxLength": 128 },
        "whatsappReady": { "type": "boolean" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientType", "type", "titleAr", "titleEn", "messageAr", "messageEn", "isRead", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
