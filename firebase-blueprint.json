    },
    "Notification": {
      "title": "Notification",
      "description": "In-app & WhatsApp-ready notification for admins or customers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientType": { "type": "string", "enum": ["admin", "customer"] },
        "recipientUid": { "type": "string", "maxLength": 128 },
        "targetPhone": { "type": "string", "maxLength": 30 },
        "type": { "type": "string", "enum": ["new_reservation", "reservation_cancelled", "reservation_updated", "low_stock", "offer_expiring", "new_customer", "invoice_issued", "back_in_stock", "price_drop", "new_course", "community_reply", "quiz_reminder", "reward_earned", "lab_approved", "badge_verified"] },
        "titleAr": { "type": "string", "maxLength": 160 },
        "titleEn": { "type": "string", "maxLength": 160 },
